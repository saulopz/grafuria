# Ignore everything by default
/*

# Include all files in the project root folder
!/*.*

# Ignore
/*.cvs
/*.csv
/settings.json

# Include the 'graph' subfolder and its files, but not its subdirectories
!graphs/
graphs/*/

# Include the 'lua' subfolder and its files, but not its subdirectories
!scripts/
scripts/*/
!scripts/nemertea/
!scripts/tutorial/


# Ignore the __pycache__ folder and its contents
__pycache__/
.vscode/
.git/
.idea/
teste/

# Include the tests folder
!tests/

# Include the source package
!src/

# CI support files; local CI virtualenv
!ci/
/.venv*/

# Documentation
!docs/
